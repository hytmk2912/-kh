# Copy to .env (never commit .env). Only FREE-tier keys.
GEMINI_API_KEY=          # Google AI Studio key from a project WITHOUT billing
GROQ_API_KEY=            # console.groq.com free tier
OPENROUTER_API_KEY=      # only ":free" models are ever called

# Wallet address that RECEIVES payments (same address on Base mainnet & Sepolia).
# For real money use an address from a wallet YOU control (MetaMask / Coinbase Wallet).
# The agent never needs the private key; leave WALLET_PRIVATE_KEY empty for mainnet.
WALLET_ADDRESS=
WALLET_PRIVATE_KEY=

# Optional overrides
# CHAIN=base_sepolia      # override config.yaml active_chain (default base_mainnet)
# WALLET_BACKEND=mock     # force offline mock wallet
# SOVEREIGN_KILL=1        # engage kill switch
